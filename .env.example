# انسخ إلى .env للتطوير المحلي. لا أسرار حقيقية هنا (§9.2).

# الترحيلات والتهيئة: دور المالك
DATABASE_ADMIN_URL=postgres://trend_owner:trend_owner@localhost:5432/trend
# خادم التطبيق: دور بلا صلاحية تجاوز RLS
DATABASE_URL=postgres://trend_api:trend_api@localhost:5432/trend
# Better Auth: دور يصل إلى مخطط auth وحده (كلمات المرور والجلسات)
AUTH_DATABASE_URL=postgres://trend_auth_api:trend_auth_api@localhost:5432/trend

PORT=4000
# سر Better Auth لتوقيع الكوكيز وتشفير أسرار TOTP (32 حرفاً على الأقل)
BETTER_AUTH_SECRET=change-me-local-dev-secret-at-least-32-chars
AUTH_BASE_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# §9.2: فحص كلمات المرور المسرّبة عبر Have I Been Pwned (يتطلب اتصالاً خارجياً)
AUTH_CHECK_PWNED=false
# §6.6: البريد عبر SMTP (SES أو Postmark أو Resend في الإنتاج). محلياً Mailpit من docker-compose،
# وصندوقه على http://localhost:8025. بلا قيمة يُكتب البريد في سجل الخادم (التطوير فقط).
MAIL_SMTP_URL=smtp://localhost:1025
MAIL_FROM="ترند <no-reply@trend.local>"
JWT_ISSUER=trend
JWT_AUDIENCE=trend-api
CORS_ORIGINS=http://localhost:3000

# الويب: عنوان الخادم (الكوكيز تعمل لأن الويب والخادم على الموقع نفسه)
NEXT_PUBLIC_API_URL=http://localhost:4000
